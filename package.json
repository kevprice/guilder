{
  "name": "the-bound-house",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "test:household": "node tools/household-scenario.mjs",
    "test:progression": "node tools/progression-scenario.mjs",
    "docs": "node generate-reference.mjs && prettier --write CHARACTERS.md CLASSES_AND_SKILLS.md HOMECOMINGS.md PERSONAL_RECORDS.md RESIDENT_DISCOVERIES.md",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm test && npm run format:check"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
